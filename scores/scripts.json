{
  "providerIdentifier": "scripts",
  "displayName": "Scripts",
  "color": "#C9A35C",
  "grouping": [
    "${metadata.runID}",
    "${metadata.script_name}",
    "${providerIdentifier}"
  ],
  "groupingWindow": "1d",
  "severityDefault": {
    "severity": "info",
    "label": "Info"
  },
  "severityRules": [
    {
      "match": {
        "label": "Critical"
      },
      "severity": "error",
      "label": "Critical"
    },
    {
      "match": {
        "label": "Critical issues"
      },
      "severity": "error",
      "label": "Critical"
    },
    {
      "match": {
        "label": "Error"
      },
      "severity": "error",
      "label": "Error"
    },
    {
      "match": {
        "label": "Elevated errors"
      },
      "severity": "warning",
      "label": "Elevated"
    },
    {
      "match": {
        "label": "Low space"
      },
      "severity": "warning",
      "label": "Warning"
    },
    {
      "match": {
        "label": "High"
      },
      "severity": "warning",
      "label": "Warning"
    },
    {
      "match": {
        "label": "Warning"
      },
      "severity": "warning",
      "label": "Warning"
    },
    {
      "match": {
        "label": "OK"
      },
      "severity": "ok",
      "label": "OK"
    }
  ],
  "defaultActions": [
    {
      "label": "SSH to source host",
      "systemIcon": "terminal",
      "trigger": {
        "openURL": "ssh://${metadata.host}"
      }
    },
    {
      "label": "Copy host",
      "systemIcon": "doc.on.doc",
      "trigger": {
        "copyToClipboard": "${metadata.host}"
      }
    },
    {
      "label": "Copy title",
      "systemIcon": "doc.on.doc",
      "trigger": {
        "copyToClipboard": "${title}"
      }
    }
  ]
}
