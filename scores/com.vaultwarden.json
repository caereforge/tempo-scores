{
  "color": "#065ADC",
  "defaultActions": [
    {
      "label": "Open vault",
      "systemIcon": "lock.shield",
      "trigger": {
        "openURL": "${metadata.ServerUrl}/"
      }
    },
    {
      "label": "Open admin",
      "systemIcon": "person.badge.key",
      "trigger": {
        "openURL": "${metadata.ServerUrl}/admin/"
      }
    },
    {
      "label": "Copy server URL",
      "systemIcon": "doc.on.doc",
      "trigger": {
        "copyToClipboard": "${metadata.ServerUrl}"
      }
    },
    {
      "label": "Copy user email",
      "systemIcon": "envelope",
      "trigger": {
        "copyToClipboard": "${metadata.UserEmail}"
      }
    },
    {
      "label": "Copy source IP",
      "systemIcon": "network",
      "trigger": {
        "copyToClipboard": "${metadata.IP}"
      }
    }
  ],
  "displayName": "Vaultwarden",
  "grouping": [
    "${metadata.UserEmail}",
    "${metadata.Event}"
  ],
  "groupingWindow": "1h",
  "helper": {
    "platforms": [
      "sh"
    ],
    "summary": "Watches the Vaultwarden log and posts auth events (failed logins, admin access) grouped per source IP."
  },
  "providerIdentifier": "com.vaultwarden",
  "senderSeverityWins": true,
  "severityDefault": {
    "label": "Info",
    "severity": "info"
  },
  "severityRules": [
    {
      "label": "Down",
      "match": {
        "Status": "down"
      },
      "severity": "critical"
    },
    {
      "label": "Unreachable",
      "match": {
        "Status": "unreachable"
      },
      "severity": "critical"
    },
    {
      "label": "Brute-force",
      "match": {
        "Event": "login_failed_burst"
      },
      "severity": "warning"
    },
    {
      "label": "Admin fail",
      "match": {
        "Event": "admin_login_failed"
      },
      "severity": "warning"
    },
    {
      "label": "Vault export",
      "match": {
        "Event": "vault_exported"
      },
      "severity": "warning"
    },
    {
      "label": "Login fail",
      "match": {
        "Event": "login_failed"
      },
      "severity": "info"
    },
    {
      "label": "Login",
      "match": {
        "Event": "user_login"
      },
      "severity": "info"
    },
    {
      "label": "New user",
      "match": {
        "Event": "user_created"
      },
      "severity": "info"
    },
    {
      "label": "Invite",
      "match": {
        "Event": "user_invited"
      },
      "severity": "info"
    },
    {
      "label": "Admin",
      "match": {
        "Event": "admin_login"
      },
      "severity": "info"
    }
  ]
}
