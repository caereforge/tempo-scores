{
  "color": "#FF0000",
  "defaultActions": [
    {
      "label": "Open in Fastmail",
      "systemIcon": "arrow.up.right.square",
      "trigger": {
        "openURL": "https://app.fastmail.com/calendar/event/${metadata.fastmail_uid}"
      }
    },
    {
      "label": "Copy event link",
      "systemIcon": "doc.on.doc",
      "trigger": {
        "copyToClipboard": "https://app.fastmail.com/calendar/event/${metadata.fastmail_uid}"
      }
    },
    {
      "label": "Email organizer",
      "systemIcon": "envelope",
      "trigger": {
        "openURL": "mailto:${metadata.fastmail_organizer_email}"
      }
    }
  ],
  "displayName": "Fastmail",
  "providerIdentifier": "com.caldav.fastmail",
  "senderSeverityWins": true,
  "surface": "agenda"
}
